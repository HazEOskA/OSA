# Run npm run setup to create a private local config. Never commit .env.
OSA_HOST=127.0.0.1
OSA_PORT=3000
OSA_PUBLIC_URL=http://127.0.0.1:3000
OSA_DB_KIND=sqlite
OSA_SQLITE_PATH=./data/osa.sqlite
# Production: postgres + independently configured credentials and TLS.
DATABASE_URL=
OSA_IDENTITIES_JSON=[]
OSA_EMBEDDED_WORKER=true
OSA_WORKER_ID=local-worker
OSA_AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=
OSA_TIMEZONE=Europe/Amsterdam
OSA_MCP_URL=http://127.0.0.1:3000
OSA_MCP_TOKEN=
